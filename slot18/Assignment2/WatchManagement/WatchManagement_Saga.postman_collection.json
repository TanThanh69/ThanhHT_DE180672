    {
      "name": "07 - Scenario F & G: DELETE Watch (Pivot)",
      "item": [
        {
          "name": "07.1 DELETE with X-Saga-Fail-After-Step: 1 -> 500 COMPENSATED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var targetId = pm.collectionVariables.get('createdWatchId') || 10;",
                  "pm.collectionVariables.set('deleteWatchId', targetId);"
                ],
                "type": "text/javascript"
              }
            },
