    {
      "name": "03 - Scenario A: CREATE Success",
      "item": [
        {
          "name": "03.1 Check Rolex watches before create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('rolexInitialCount', jsonData.data.watchCount);",
                  "pm.test('Rolex has watches', function () { pm.expect(jsonData.data.watchCount).to.be.at.least(1); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/brands/1/watches"
          }
        },
        {
          "name": "03.2 CREATE Watch (brand 1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date().toISOString().split('T')[0];",
                  "pm.collectionVariables.set('todayDate', today);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var sagaId = pm.response.headers.get('X-Saga-Id');",
                  "pm.test('Has X-Saga-Id header', function () { pm.expect(sagaId).to.not.be.empty; });",
                  "pm.collectionVariables.set('createdSagaId', sagaId);",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('createdWatchId', jsonData.data.watchId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Oyster Perpetual Celebration\",\n  \"categoryId\": 3,\n  \"brandId\": 1,\n  \"caseMaterial\": \"Oystersteel\",\n  \"strapMaterial\": \"Oystersteel\",\n  \"waterpMaterial\": \"100 meters\",\n  \"price\": 6150.00,\n  \"releaseDate\": \"{{todayDate}}\",\n  \"stock\": 15\n}"
            },
            "url": "{{baseUrl}}/api/watches"
          }
        },
        {
          "name": "03.3 Check Rolex watches after create -> count 3",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "var initial = parseInt(pm.collectionVariables.get('rolexInitialCount') || 2);",
                  "pm.test('Rolex watchCount increased by 1', function () { pm.expect(jsonData.data.watchCount).to.eql(initial + 1); });",
                  "pm.test('Rolex contains createdWatchId', function () {",
                  "  var id = pm.collectionVariables.get('createdWatchId');",
                  "  pm.expect(jsonData.data.watchIds).to.include(id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/brands/1/watches"
          }
        },
        {
          "name": "03.4 Verify Saga Status -> COMPLETED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Saga is COMPLETED', function () { pm.expect(jsonData.data.status).to.eql('COMPLETED'); });",
                  "pm.test('Steps have CREATE_WATCH and ASSIGN_BRAND SUCCESS', function () {",
                  "  pm.expect(jsonData.data.steps.length).to.eql(2);",
                  "  pm.expect(jsonData.data.steps[0].stepName).to.eql('CREATE_WATCH');",
                  "  pm.expect(jsonData.data.steps[1].stepName).to.eql('ASSIGN_BRAND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/sagas/{{createdSagaId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Scenario B: CREATE Brand 999 (Compensation)",
      "item": [
        {
          "name": "04.1 CREATE Watch with brandId = 999 -> 400 COMPENSATED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date().toISOString().split('T')[0];",
                  "pm.collectionVariables.set('todayDate', today);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "var sagaId = pm.response.headers.get('X-Saga-Id');",
                  "pm.collectionVariables.set('failBrandSagaId', sagaId);",
                  "var jsonData = pm.response.json();",
                  "pm.test('sagaStatus is COMPENSATED', function () { pm.expect(jsonData.data.sagaStatus).to.eql('COMPENSATED'); });",
                  "pm.test('failedStep is ASSIGN_BRAND', function () { pm.expect(jsonData.data.failedStep).to.eql('ASSIGN_BRAND'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phantom Luxury Watch 999\",\n  \"categoryId\": 1,\n  \"brandId\": 999,\n  \"caseMaterial\": \"Titanium\",\n  \"strapMaterial\": \"Titanium\",\n  \"waterpMaterial\": \"500 meters\",\n  \"price\": 12000.00,\n  \"releaseDate\": \"{{todayDate}}\",\n  \"stock\": 5\n}"
            },
            "url": "{{baseUrl}}/api/watches"
          }
        },
        {
          "name": "04.2 Verify Saga Log: DELETE_WATCH Compensated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Status is COMPENSATED', function () { pm.expect(jsonData.data.status).to.eql('COMPENSATED'); });",
                  "var steps = jsonData.data.steps;",
                  "pm.test('Has 3 log steps: EXECUTE, FAILED, COMPENSATE', function () {",
                  "  pm.expect(steps.length).to.be.at.least(3);",
                  "  pm.expect(steps[0].stepName).to.eql('CREATE_WATCH');",
                  "  pm.expect(steps[0].result).to.eql('SUCCESS');",
                  "  pm.expect(steps[1].stepName).to.eql('ASSIGN_BRAND');",
                  "  pm.expect(steps[1].result).to.eql('FAILED');",
                  "  pm.expect(steps[2].stepName).to.eql('DELETE_WATCH');",
                  "  pm.expect(steps[2].result).to.eql('SUCCESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/sagas/{{failBrandSagaId}}"
          }
        }
      ]
    },
    {
      "name": "05 - Scenario C: CREATE + Fault Injection (LIFO)",
      "item": [
        {
          "name": "05.1 CREATE with X-Saga-Fail-After-Step: 2 -> 500 COMPENSATED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const today = new Date().toISOString().split('T')[0];",
                  "pm.collectionVariables.set('todayDate', today);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 500', function () { pm.response.to.have.status(500); });",
                  "var sagaId = pm.response.headers.get('X-Saga-Id');",
                  "pm.collectionVariables.set('faultCreateSagaId', sagaId);",
                  "var jsonData = pm.response.json();",
                  "pm.test('sagaStatus is COMPENSATED', function () { pm.expect(jsonData.data.sagaStatus).to.eql('COMPENSATED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Saga-Fail-After-Step", "value": "2" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Simulated Fault Watch\",\n  \"categoryId\": 1,\n  \"brandId\": 1,\n  \"caseMaterial\": \"Steel\",\n  \"strapMaterial\": \"Rubber\",\n  \"waterpMaterial\": \"300m\",\n  \"price\": 3500.00,\n  \"releaseDate\": \"{{todayDate}}\",\n  \"stock\": 10\n}"
            },
            "url": "{{baseUrl}}/api/watches"
          }
        },
        {
          "name": "05.2 Verify LIFO Compensation: UNASSIGN then DELETE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "var steps = jsonData.data.steps;",
                  "pm.test('UNASSIGN_BRAND before DELETE_WATCH', function () {",
                  "  var unassignIdx = steps.findIndex(s => s.stepName === 'UNASSIGN_BRAND');",
                  "  var deleteIdx = steps.findIndex(s => s.stepName === 'DELETE_WATCH');",
                  "  pm.expect(unassignIdx).to.be.greaterThan(-1);",
                  "  pm.expect(deleteIdx).to.be.greaterThan(-1);",
                  "  pm.expect(unassignIdx).to.be.below(deleteIdx);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/sagas/{{faultCreateSagaId}}"
          }
        }
      ]
    },
